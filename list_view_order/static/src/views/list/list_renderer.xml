<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-inherit="web.ListRenderer" t-inherit-mode="extension">
    <xpath expr="//Dropdown/t[@t-set-slot='content']" position="inside">
        <t t-if="this.isListViewEditable ? this.isListViewEditable() : false">
            <div t-if="hasOptionalFields" class="dropdown-divider"/>
            <DropdownItem closingMode="'none'" onSelected="() => this.onSelectedRearrangeListView()" class="'dropdown-item-rearrange-list'">
                <i class="fa fa-sort fa-fw me-2"/>
                <span>Rearrange List</span>
            </DropdownItem>
        </t>
    </xpath>
</t>

</templates>
